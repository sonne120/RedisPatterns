{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Redis": {
    "ConnectionString": "localhost:6379,abortConnect=false,allowAdmin=true",
    "KeyPrefix": "app"
  },

  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=patterns;Username=patterns;Password=patterns"
  },

  "Kafka": {
    "Enabled": true,
    "BootstrapServers": "localhost:9092",
    "OrdersTopic": "orders",
    "ConsumerGroup": "order-processor",
    "TransactionsTopic": "transactions",
    "ProjectionGroup": "srv-read-projection"
  },

  "CacheAside": {
    "Ttl": "00:10:00",
    "TtlJitter": "00:02:00",
    "NegativeTtl": "00:00:30",
    "RebuildLockTtl": "00:00:10",
    "RebuildWaitTimeout": "00:00:03"
  }
}
